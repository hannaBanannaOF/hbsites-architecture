# Copie para .env (nesta pasta) e altere só o que precisar.
# Vale para os dois composes; o que ficar de fora usa o padrão mostrado aqui.

# --- Versões das imagens ---
GATEWAY_VERSION=1.1.0
CORE_VERSION=1.5.0
FRONTEND_VERSION=1.0.0

# --- Portas no host ---
KEYCLOAK_PORT=8080
KEYCLOAK_DB_PORT=5432
GATEWAY_PORT=8081
GATEWAY_DB_PORT=27018
CORE_PORT=8082
CORE_DB_PORT=5433
FRONTEND_PORT=3000

# --- URLs vistas pelo navegador ---
# Se mudar GATEWAY_PUBLIC_URL, atualize o redirect URI do client "questmaster" no Keycloak.
FRONTEND_URL=http://localhost:3000
GATEWAY_PUBLIC_URL=http://localhost:8081
KEYCLOAK_PUBLIC_URL=http://localhost:8080
COOKIE_DOMAIN=localhost

# --- Segredos ---
# As senhas de banco só valem na criação do volume; para trocar depois, apague o volume (down -v).
KEYCLOAK_ADMIN_PASSWORD=password
KEYCLOAK_DB_PASSWORD=postgres
CORE_DB_PASSWORD=postgres
GATEWAY_DB_PASSWORD=mongodb
# Precisa ser o secret do client "questmaster" no realm
KEYCLOAK_CLIENT_SECRET=xKa7P5CGXwoYnSjQrI7g9UUXYP16LXOw
